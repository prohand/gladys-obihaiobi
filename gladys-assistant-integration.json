  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "The integration reads the status pages of your OBi box on your local network, like its web interface does. No cloud and no OBiTALK account: enter the IP address of the box and the password of its web interface (admin account to allow reboots).",
        "fr": "L'intégration lit les pages d'état de votre boîtier OBi sur votre réseau local, comme son interface web. Pas de cloud ni de compte OBiTALK : saisissez l'adresse IP du boîtier et le mot de passe de son interface web (compte admin pour autoriser le redémarrage).",
        "de": "Die Integration liest die Statusseiten deiner OBi-Box in deinem lokalen Netzwerk, wie ihre Weboberfläche. Keine Cloud und kein OBiTALK-Konto: Gib die IP-Adresse der Box und das Passwort ihrer Weboberfläche ein (Admin-Konto, um Neustarts zu erlauben).",
        "es": "La integración lee las páginas de estado de su equipo OBi en su red local, como su interfaz web. Sin nube ni cuenta OBiTALK: introduzca la dirección IP del equipo y la contraseña de su interfaz web (cuenta admin para permitir reinicios)."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-obihaiobi/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "Address of the OBi box",
        "fr": "Adresse du boîtier OBi",
        "de": "Adresse der OBi-Box",
        "es": "Dirección del equipo OBi"
      },
      "description": {
        "en": "IP address or host name of the box on your network (dial ***1 on a phone plugged into it to hear it). Several boxes with the same password: separate them with commas.",
        "fr": "Adresse IP ou nom du boîtier sur votre réseau (composez ***1 sur un téléphone branché dessus pour l'entendre). Plusieurs boîtiers avec le même mot de passe : séparez-les par des virgules.",
        "de": "IP-Adresse oder Hostname der Box in deinem Netzwerk (wähle ***1 an einem angeschlossenen Telefon, um sie anzusagen). Mehrere Boxen mit demselben Passwort: durch Kommas trennen.",
        "es": "Dirección IP o nombre del equipo en su red (marque ***1 en un teléfono conectado para oírla). Varios equipos con la misma contraseña: sepárelos con comas."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50",
        "de": "z. B. 192.168.1.50",
        "es": "p. ej. 192.168.1.50"
      },
      "required": true
    },
    {
      "key": "username",
      "type": "select",
      "label": {
        "en": "Account",
        "fr": "Compte",
        "de": "Konto",
        "es": "Cuenta"
      },
      "description": {
        "en": "Account of the OBi web interface. admin can reboot the box; user can only read it.",
        "fr": "Compte de l'interface web de l'OBi. admin peut redémarrer le boîtier ; user peut seulement le lire.",
        "de": "Konto der OBi-Weboberfläche. admin kann die Box neu starten; user kann sie nur lesen.",
        "es": "Cuenta de la interfaz web del OBi. admin puede reiniciar el equipo; user solo puede leerlo."
      },
      "required": false,
      "default": "admin",
      "options": [
        {
          "value": "admin",
          "label": {
            "en": "admin",
            "fr": "admin",
            "de": "admin",
            "es": "admin"
          }
        },
        {
          "value": "user",
          "label": {
            "en": "user (read only)",
            "fr": "user (lecture seule)",
            "de": "user (nur lesen)",
            "es": "user (solo lectura)"
          }
        }
      ]
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "description": {
        "en": "Password of that account (admin by default on a new box: change it).",
        "fr": "Mot de passe de ce compte (admin par défaut sur un boîtier neuf : changez-le).",
        "de": "Passwort dieses Kontos (standardmäßig admin bei einer neuen Box: ändere es).",
        "es": "Contraseña de esa cuenta (admin por defecto en un equipo nuevo: cámbiela)."
      },
      "required": true
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the boxes are read, in seconds. Keep it short (5 s) to catch incoming calls while the phone rings.",
        "fr": "Fréquence de lecture des boîtiers, en secondes. Gardez-la courte (5 s) pour voir les appels entrants pendant que le téléphone sonne.",
        "de": "Wie oft die Boxen gelesen werden, in Sekunden. Kurz halten (5 s), um eingehende Anrufe zu sehen, solange das Telefon klingelt.",
        "es": "Frecuencia de lectura de los equipos, en segundos. Manténgala corta (5 s) para detectar las llamadas entrantes mientras suena el teléfono."
      },
      "required": false,
      "default": 5,
      "min": 2,
      "max": 3600
    }
  ],
