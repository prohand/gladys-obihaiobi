{
  "manifest_version": 1,
  "type": "device",
  "name": "Obihai OBi",
  "description": {
    "en": "Follow your Obihai OBi VoIP adapters: SIP lines, phone ports, incoming calls and reboot.",
    "fr": "Suivez vos adaptateurs VoIP Obihai OBi : lignes SIP, ports téléphone, appels et redémarrage.",
    "de": "Überwache deine Obihai-OBi-VoIP-Adapter: SIP-Leitungen, Telefonports, Anrufe und Neustart.",
    "es": "Siga sus adaptadores VoIP Obihai OBi: líneas SIP, puertos, llamadas entrantes y reinicio."
  },
  "version": "0.1.1",
  "docker_image": "ghcr.io/prohand/gladys-obihaiobi:0.1.1",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-obihaiobi/main/cover.png",
  "categories": ["network", "notifications"],
  "keywords": [
    "obi200",
    "obi202",
    "obi110",
    "obi302",
    "obitalk",
    "voip",
    "sip",
    "ata",
